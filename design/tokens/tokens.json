        {
          "color": "#1d19150a",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px"
        },
        {
          "color": "#1d19150d",
          "offsetX": "0px",
          "offsetY": "6px",
          "blur": "20px",
          "spread": "-4px"
        }
      ],
      "$description": "Spoczynek: karty i panele na tle strony. Ledwie odrywa papier od blatu."
    },
    "uniesiony": {
