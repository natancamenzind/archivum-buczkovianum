msgstr "Wybierz tekst rodzaju „%s”."

#, python-format
msgid ""
"The text this item holds has %(count)d tagged fragment. Delete them before "
"removing the text."
msgid_plural ""
"The text this item holds has %(count)d tagged fragments. Delete them before "
"removing the text."
msgstr[0] ""
"Tekst tego bytu ma %(count)d otagowany fragment. Usuń go przed usunięciem "
"tekstu."
