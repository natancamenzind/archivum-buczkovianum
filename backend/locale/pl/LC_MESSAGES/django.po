msgid "Leave this empty for this kind of content."
msgstr "Przy tym rodzaju treści zostaw to pole puste."

msgid "Or enter the text here instead of uploading a scan and an OCR file."
msgstr "Albo wpisz tekst tutaj, zamiast wgrywać skan i plik OCR."

msgid "Upload a scan and its OCR file, or enter a plain text, not both."
msgstr "Wgraj skan z plikiem OCR albo wpisz tekst lity, nie jedno i drugie."

msgid "Upload a scan and its OCR file, or enter a plain text."
msgstr "Wgraj skan z plikiem OCR albo wpisz tekst lity."

