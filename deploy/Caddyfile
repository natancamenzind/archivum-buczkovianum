# The test environment (US-OPS-01): automatic HTTPS for SITE_DOMAIN, the whole site behind
# basic auth except /healthz, and never indexed.

{$SITE_DOMAIN} {
	request_body {
		max_size 200MB
	}

	header X-Robots-Tag "noindex, nofollow"

	@protected not path /healthz
	basic_auth @protected {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	reverse_proxy app:8000
}
