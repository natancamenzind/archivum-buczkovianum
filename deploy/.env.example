# Copy to deploy/.env (gitignored) and fill in. Read by deploy/compose.yml and the scripts.
# Wrap a value in single quotes if it contains `$`, so Compose does not expand it.

# --- Site and Caddy ---
# Public hostname; Caddy gets its certificate for it. DNS must point at this server.
SITE_DOMAIN=test.example.org
# Basic auth user for the whole site except /healthz.
BASIC_AUTH_USER=editor
# Bcrypt hash of the password: docker run --rm caddy:2 caddy hash-password --plaintext '...'
BASIC_AUTH_HASH='$2a$14$replace-with-the-output-of-caddy-hash-password'

# --- PostgreSQL ---
# Database user, created on the first start of an empty volume.
POSTGRES_USER=buczkovianum
# Its password. URL-safe characters only, as it goes into DATABASE_URL: openssl rand -hex 32
POSTGRES_PASSWORD=change-me
# Database name, created on the first start of an empty volume.
POSTGRES_DB=buczkovianum

# --- Django ---
# compose.yml sets DEBUG=false and builds DATABASE_URL from the three values above, and
# ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS from SITE_DOMAIN.
# Long random string: python -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=change-me

# --- S3: media and backups ---
# Private bucket for uploaded media, served through presigned URLs.
AWS_STORAGE_BUCKET_NAME=
# Region of both buckets, e.g. eu-central-1.
AWS_S3_REGION_NAME=
# Only for an S3-compatible service other than AWS; leave empty for AWS.
AWS_S3_ENDPOINT_URL=
# Access key with read/write on the media bucket and on BACKUP_BUCKET.
AWS_ACCESS_KEY_ID=
# Its secret.
AWS_SECRET_ACCESS_KEY=
# Bucket for database dumps (deploy/backup.sh writes to s3://$BACKUP_BUCKET/db/).
BACKUP_BUCKET=
