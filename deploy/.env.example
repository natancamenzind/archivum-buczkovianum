# Every variable of the test environment (US-OPS-01 AC8). On Render they come from render.yaml:
# a fixed value, a reference, or "sync: false", which Render asks for when the Blueprint is first
# synced. Nothing reads this file there. Locally, a repo-root .env uses the same names.

# --- archivum-test (web service) ---
# From render.yaml: the connection string of archivum-test-db-v2 over the private network.
DATABASE_URL=postgres://archivum:change-me@archivum-test-db-v2:5432/archivum
# From render.yaml. Always false here; true only for local development.
DEBUG=false
# From render.yaml: generated by Render on the first sync.
SECRET_KEY=change-me
# From render.yaml: the service's own onrender.com hostname (RENDER_EXTERNAL_HOSTNAME).
ALLOWED_HOSTS=archivum-test.onrender.com
# Optional, not in render.yaml. Without it, https://<host> for every entry in ALLOWED_HOSTS.
CSRF_TRUSTED_ORIGINS=
# From render.yaml: `simple` on PostgreSQL 18, which has no `polish` (architecture section 6).
SEARCH_TS_CONFIG=simple
# From render.yaml: true adds X-Robots-Tag: noindex, nofollow to every response.
ROBOTS_NOINDEX=true
# From render.yaml: region of the media bucket.
AWS_S3_REGION_NAME=eu-north-1
# Only for an S3-compatible service other than AWS; not in render.yaml, so AWS.
AWS_S3_ENDPOINT_URL=
# Optional, not in render.yaml. Basic auth user for the whole site except /healthz; off unless both are set.
BASIC_AUTH_USER=
# Optional. Basic auth password: openssl rand -base64 24
BASIC_AUTH_PASSWORD=
# Secret. The first editor account, created once by the initial deploy hook (createsuperuser).
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
# Secret. Private bucket for uploaded media, served through presigned URLs.
AWS_STORAGE_BUCKET_NAME=
# Secret. Access key with read/write on the media bucket.
AWS_ACCESS_KEY_ID=
# Secret. Its secret.
AWS_SECRET_ACCESS_KEY=
