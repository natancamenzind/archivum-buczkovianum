# Every variable of the test environment (US-OPS-01 AC9). On Railway these are service
# variables; nothing reads this file there. Locally, a repo-root .env uses the same names.

# --- postgres service ---
# Database user, created on the first start of an empty volume.
POSTGRES_USER=buczkovianum
# Its password. URL-safe characters only, as it goes into DATABASE_URL: openssl rand -hex 32
POSTGRES_PASSWORD=change-me
# Database name, created on the first start of an empty volume.
POSTGRES_DB=buczkovianum

# --- app service ---
# A reference to the postgres service over the private network (docs/deploy.md, Setup).
DATABASE_URL=postgres://${{postgres.POSTGRES_USER}}:${{postgres.POSTGRES_PASSWORD}}@${{postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/${{postgres.POSTGRES_DB}}
# Always false here; true only for local development.
DEBUG=false
# Long random string: python -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=change-me
# The public domain, plus the host Railway's healthcheck sends.
ALLOWED_HOSTS=test.example.org,healthcheck.railway.app
# The public origin, with its scheme.
CSRF_TRUSTED_ORIGINS=https://test.example.org
# Basic auth user for the whole site except /healthz; basic auth is off unless both are set.
BASIC_AUTH_USER=editor
# Basic auth password: openssl rand -base64 24
BASIC_AUTH_PASSWORD=change-me
# true adds X-Robots-Tag: noindex, nofollow to every response.
ROBOTS_NOINDEX=true
# Private bucket for uploaded media, served through presigned URLs.
AWS_STORAGE_BUCKET_NAME=
# Region of both buckets, e.g. eu-central-1.
AWS_S3_REGION_NAME=
# Only for an S3-compatible service other than AWS; leave empty for AWS.
AWS_S3_ENDPOINT_URL=
# Access key with read/write on the media bucket and on BACKUP_BUCKET.
AWS_ACCESS_KEY_ID=
# Its secret.
AWS_SECRET_ACCESS_KEY=

# --- backup service ---
# Also set here: DATABASE_URL and the four AWS_* values above (not AWS_STORAGE_BUCKET_NAME).
# Bucket for database dumps; deploy/backup.sh writes to s3://$BACKUP_BUCKET/db/.
BACKUP_BUCKET=
