SECRET_KEY=change-me
# With DEBUG=false every variable below except SEARCH_TS_CONFIG and AWS_S3_ENDPOINT_URL is
# required, and startup fails naming the first one missing.
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# The Vite dev server (`make dev`) proxies /admin to Django; its origin must be trusted.
CSRF_TRUSTED_ORIGINS=http://localhost:5173
DATABASE_URL=postgres://localhost:5432/buczkovianum
# Set to `simple` only if your PostgreSQL is older than 19 (no Polish inflection then).
SEARCH_TS_CONFIG=polish

# Leave empty to store media on the local filesystem.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
